{
  "name": "golfcalc-sync-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Secure live-round sync relay for GolfCalculator (Cloudflare Worker + Durable Objects)",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --env production",
    "deploy:staging": "wrangler deploy --env staging",
    "test": "vitest run",
    "types": "wrangler types --check",
    "check": "wrangler deploy --dry-run --env production"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.20.3",
    "@cloudflare/workers-types": "5.20260804.1",
    "@types/node": "26.1.2",
    "vitest": "4.1.10",
    "wrangler": "4.120.0"
  }
}
