{
  "name": "golfcalculator",
  "version": "2.2.1",
  "private": true,
  "scripts": {
    "sync:version": "node scripts/sync-version.mjs",
    "check:version": "node scripts/sync-version.mjs --check",
    "version": "npm run sync:version",
    "test": "npm run test:unit && npm run test:browser",
    "verify": "npm run check:version && npm run test && npm --prefix sync-worker run check",
    "verify:release": "npm run verify && npm audit --audit-level=high && npm --prefix sync-worker audit --audit-level=high",
    "test:unit": "node --test tests/*.test.js && npm --prefix sync-worker test",
    "test:scoring": "node --test tests/scoring.test.js",
    "test:worker": "npm --prefix sync-worker test",
    "test:browser": "playwright test",
    "smoke:production": "node scripts/production-smoke.mjs",
    "catalog:inventory": "node scripts/swedish-course-inventory.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1"
  },
  "dependencies": {
    "dompurify": "3.4.13"
  }
}
