{
  "name": "golfcalculator",
  "version": "2.1.0",
  "private": true,
  "scripts": {
    "test": "npm run test:unit && npm run test:browser",
    "test:unit": "node --test tests/*.test.js && npm --prefix sync-worker test",
    "test:scoring": "node --test tests/scoring.test.js",
    "test:worker": "npm --prefix sync-worker test",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.54.2"
  }
}
